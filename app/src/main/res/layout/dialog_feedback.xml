<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feedback"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="50dp"
        android:layout_height="3dp"
        android:background="@color/accent_blue"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp" />

    <!-- Feedback input box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_box_bg"
        android:layout_marginBottom="6dp">

        <EditText
            android:id="@+id/etFeedback"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="Write your feedback here..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp"
            android:padding="14dp"
            android:inputType="textMultiLine" />
    </FrameLayout>

    <!-- Word count indicator -->
    <TextView
        android:id="@+id/tvWordCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0/200 words"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="end"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We value your feedback"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="18dp" />

    <!-- Cancel button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Cancel"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/circle_icon_bg"
        app:cornerRadius="23dp"
        android:layout_marginBottom="10dp" />

    <!-- Submit button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Submit"
        android:textColor="@color/bg_dark"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="23dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        android:indeterminateTint="@color/accent_blue" />

</LinearLayout>