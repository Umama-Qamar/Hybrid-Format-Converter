<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Shield Icon -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/circle_icon_bg"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield"
            android:tint="@color/accent_blue" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permission Required"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app needs access to proceed with file conversion"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Dynamic message box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_box_bg"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvDynamicMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If you want to convert JPG to SVG, allow permission to access files."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />
    </FrameLayout>

    <!-- Info note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_info"
            android:tint="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="We only access files for conversion. No data is stored without your permission."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Allow access button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllowAccess"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Allow access"
        android:textColor="@color/bg_dark"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="23dp"
        android:layout_marginBottom="10dp" />

    <!-- Only this time button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOnlyThisTime"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Only this time"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/circle_icon_bg"
        app:cornerRadius="23dp"
        android:layout_marginBottom="10dp" />

    <!-- Don't allow button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDontAllow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Don't allow"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        app:backgroundTint="@color/circle_icon_bg"
        app:cornerRadius="23dp" />

</LinearLayout>